# ─── MayaClone Configuration ───

# Deepgram (STT) — Get a free key at https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=flux-general-en
# Optional Flux turn tuning (only used with Flux models)
# FLUX_EAGER_EOT_THRESHOLD=0.45
# FLUX_EOT_THRESHOLD=0.30
# FLUX_EOT_TIMEOUT_MS=800

# LLM (OpenAI-compatible chat/completions endpoint)
# Examples:
# Groq:   https://api.groq.com/openai/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# Local:  http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=openai/gpt-4o-mini
LLM_MAX_TOKENS=300
LLM_MAX_CONTEXT_TOKENS=128000
# Optional bootstrap sampling defaults for first run only. After that MayaClone persists
# provider settings and profiles under config/llm-provider-settings.json.
LLM_TEMPERATURE=0.78
LLM_TOP_P=0.92

# TTS backend (Vox)
TTS_ENDPOINT=http://localhost:8002
TTS_BACKEND=vox
TTS_VOICE=step_0003500

# Vox TTS tuning
VOX_CFG=2.0
VOX_MAX_LEN=384
VOX_SEAM_MS=45
VOX_SPLIT_STEERS=1
TTS_PRESERVE_STEERS=1
TTS_SOFTEN_EXCLAMATIONS=0
TTS_EXCLAMATION_KEEP_RATE=1.0
TTS_MIN_CHUNK_SIZE_FIRST=2048
TTS_MIN_CHUNK_SIZE_STREAM=4096
TTS_BLOCK_SIZES=32,128,480
TTS_NUM_STEPS=15,20,20
TTS_FIRST_CHUNK_BLOCK_SIZES=32,128,480
TTS_FIRST_CHUNK_NUM_STEPS=6,12,20
TTS_TOKEN_TARGETS=10,28,42,50,55,55,60,60
TTS_CHUNK_FLEX=1.0

# Legacy compatibility knobs; ignored by Vox.
TTS_CFG_SCALE_TEXT=2.5
TTS_CFG_SCALE_SPEAKER=5
TTS_TRUNCATION_FACTOR=0.9
TTS_SPEAKER_KV_SCALE=1
TTS_SEED=0

# Optional debugging
DEBUG_TTS=0
LOG_LLM_RESPONSE_MAX_CHARS=2500

# Server
PORT=3000
