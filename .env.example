# ─── MayaClone Configuration ───

# Deepgram (STT) — Get a free key at https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=flux-general-en
# Optional Flux turn tuning (only used with Flux models)
# FLUX_EAGER_EOT_THRESHOLD=0.45
# FLUX_EOT_THRESHOLD=0.30
# FLUX_EOT_TIMEOUT_MS=800

# LLM (OpenAI-compatible chat/completions endpoint)
# Examples:
# Groq:   https://api.groq.com/openai/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# Local:  http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=moonshotai/kimi-k2-instruct-0905
LLM_MAX_TOKENS=300

# TTS backend (must expose POST /v1/audio/speech and return PCM audio)
# MayaClone is tuned for EchoTTS-compatible backends.
TTS_ENDPOINT=http://localhost:8002
TTS_VOICE=mayalong9

# EchoTTS tuning
TTS_BLOCK_SIZES=32,128,480
TTS_NUM_STEPS=15,20,20
TTS_FIRST_CHUNK_BLOCK_SIZES=32,128,480
TTS_FIRST_CHUNK_NUM_STEPS=6,12,20
TTS_TOKEN_TARGETS=15,40,50,50,50,50,60,60,61
TTS_CHUNK_FLEX=1.0
TTS_CFG_SCALE_TEXT=2.5
TTS_CFG_SCALE_SPEAKER=5
TTS_TRUNCATION_FACTOR=0.9
TTS_SPEAKER_KV_SCALE=1
TTS_SEED=0

# Optional debugging
DEBUG_TTS=0
LOG_LLM_RESPONSE_MAX_CHARS=2500

# Server
PORT=3000
